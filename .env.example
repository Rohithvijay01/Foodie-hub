# Project configuration
PROJECT_NAME="Foodie Hub"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="development_secret_key_change_in_production"
ALGORITHM="HS256"

# Database configuration for local SQLite run
DATABASE_URL="sqlite+aiosqlite:///:memory:"
AUTO_CREATE_TABLES=true

# Docker Compose / Postgres configuration (Sensible defaults for local compose run)
POSTGRES_USER=foodie_user
POSTGRES_PASSWORD=foodie_password
POSTGRES_DB=foodie_db
# In Docker environment, uncomment DATABASE_URL below to point to the postgres container:
# DATABASE_URL="postgresql+asyncpg://foodie_user:foodie_password@db:5432/foodie_db"

# Port mapping for the backend container (default: 8000)
APP_PORT=8000

# Security & CORS configuration
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Email Configuration (e.g. Mailtrap for development password resets)
MAILTRAP_API_TOKEN="YourMailtrapAPITokenHere"
MAILTRAP_ACCOUNT_ID="YourMailtrapAccountIDHere"
EMAIL_FROM="noreply@foodiehub.com"
EMAIL_FROM_NAME="Foodie Hub Support"
FRONTEND_URL="http://localhost:3000"

# Redis & Rate Limiting Configuration
# (If Redis is offline, the application will automatically run cache-less and disable rate limiting gracefully)
REDIS_URL="redis://localhost:6379/0"
ENABLE_RATE_LIMITING=true
RATE_LIMIT=100
RATE_WINDOW=60

# SSE Notification Configuration
NOTIFICATION_CHANNEL_PREFIX="notifications"
SSE_RETRY_MS=15000
SSE_HEARTBEAT_SECONDS=20
SSE_POLL_TIMEOUT_SECONDS=1
SSE_MAX_GROUPS_PER_CONNECTION=5
